{
  "name": "blueprint",
  "productName": "Blueprint",
  "version": "0.2.0",
  "private": true,
  "description": "Blueprint: local visual maps of ideas and systems",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "test:ui": "node scripts/interaction-test.mjs",
    "package:dir": "electron-builder --config electron-builder.config.cjs --mac dir --publish never",
    "test:net": "node scripts/network-test.mjs",
    "test:launch": "node scripts/launch-test.mjs",
    "test:mcp-exit": "node scripts/mcp-exit-test.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "license": "MIT"
}
